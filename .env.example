# ka-hgis GitHub 접근 설정 (예시)
#
# 이 파일에는 실제 값을 넣지 않는다. 저장소에 커밋되는 템플릿이다.
# 실제 값은 저장소 밖 파일에 둔다:
#   %USERPROFILE%\.config\ka-hgis\git.env
# 불러오기:
#   . .\scripts\load-git-env.ps1
#
# 토큰은 fine-grained personal access token 을 권장한다.
#   - 대상 저장소: kesekikwon-netizen/gogohak1 하나만
#   - 권한: Contents = Read and write (필요하면 Pull requests 추가)
#   - 만료: 90일
# 원격 주소에 토큰을 넣지 않는다. https://<토큰>@github.com/... 형태는
# .git/config 와 셸 기록에 평문으로 남는다.

GH_TOKEN=
GITHUB_REPOSITORY=kesekikwon-netizen/gogohak1
GIT_REMOTE_URL=https://github.com/kesekikwon-netizen/gogohak1.git
