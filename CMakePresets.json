{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio 2022 (기본 빌드)",
      "description": "실제 빌드용. 기존 build/ 디렉토리를 그대로 사용한다.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "OSGEO4W_ROOT": "$env{OSGEO4W_ROOT}",
        "KA_HGIS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja, 평소 개발)",
      "description": "리눅스 개발용. 결과는 build-linux/. 커밋 전 검사가 이 폴더를 증거로 본다.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KA_HGIS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release 빌드",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug 빌드",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "linux",
      "displayName": "Linux 빌드",
      "configurePreset": "linux"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "displayName": "테스트 (Release)",
      "configurePreset": "vs",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux",
      "displayName": "테스트 (Linux)",
      "configurePreset": "linux",
      "environment": { "QT_QPA_PLATFORM": "offscreen" },
      "output": { "outputOnFailure": true }
    }
  ]
}
